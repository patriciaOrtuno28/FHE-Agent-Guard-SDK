# Copy to .env.local and fill in your values.

# ── Server-side RPC URLs (never sent to the browser) ─────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v3/YOUR_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v3/YOUR_KEY

INFERENCE_URL=http://localhost:8000
INFERENCE_API_KEY=change-this-long-random-string

# ── Contract addresses (NEXT_PUBLIC_ = readable by the browser) ───────────────
# Set after running: pnpm deploy:sepolia && pnpm contracts:export:sepolia
NEXT_PUBLIC_TRUST_SCORE_AGENT_SEPOLIA=0x<address_from_deploy_output>

# ── Admin: minimum trust score required to access the platform (0–10) ─────────
NEXT_PUBLIC_REQUIRED_SCORE=7

# ── Upstash Redis (required — used for user storage and rate limiting) ────────
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your deployed domain in production (e.g. https://yourdomain.com)
ALLOWED_ORIGIN=https://yourdomain.com

# ── Error tracking (optional) ─────────────────────────────────────────────────
# Create a Next.js project at https://sentry.io (free tier: 5 000 errors/month)
# Leave blank to run without error tracking.
NEXT_PUBLIC_SENTRY_DSN=
