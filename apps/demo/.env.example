# Copy to .env.local and fill in your values.

# ── Server-side RPC URLs (never sent to the browser) ─────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v3/YOUR_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v3/YOUR_KEY

INFERENCE_URL=http://localhost:8000
INFERENCE_API_KEY=change-this-long-random-string

# ── Contract addresses (NEXT_PUBLIC_ = readable by the browser) ───────────────
# Set after running: pnpm deploy:sepolia && pnpm contracts:export:sepolia
NEXT_PUBLIC_TRUST_SCORE_AGENT_SEPOLIA=0x<address_from_the_deploy_output>
# NEXT_PUBLIC_TRUST_SCORE_AGENT_LOCALHOST=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ── Rate limiting ───────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SCAN_RATE_LIMIT_MAX=10
SCAN_RATE_LIMIT_WINDOW=60 s

# ── CORS ───────────────
# TODO: Fill in after Vercel deployment, or set to localhost for local testing
ALLOWED_ORIGIN=https://yourdomain.com
