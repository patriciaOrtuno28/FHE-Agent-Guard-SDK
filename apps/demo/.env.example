# Copy to .env.local and fill in your values.

# ── Server-side RPC URLs (never sent to the browser) ─────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
LOCAL_RPC_URL=http://localhost:8545

INFERENCE_URL=http://localhost:8000

# ── Contract addresses (NEXT_PUBLIC_ = readable by the browser) ───────────────
# Set after running: pnpm deploy:sepolia && pnpm contracts:export:sepolia
NEXT_PUBLIC_ANOMALY_AGENT_SEPOLIA=0x<address_from_the_deploy_output>
# NEXT_PUBLIC_ANOMALY_AGENT_LOCALHOST=0x5FbDB2315678afecb367f032d93F642f64180aa3
