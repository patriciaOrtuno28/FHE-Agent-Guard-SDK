{
  "name": "@fhe-guard/plugin",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "FHE-based trust score plugin for Next.js login flows",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fhe-guard/sdk": "workspace:*",
    "viem": "^2.21.0"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "next": "^14.2.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.4",
    "@types/react": "^18.3.0",
    "@types/node": "^20.0.0"
  }
}
