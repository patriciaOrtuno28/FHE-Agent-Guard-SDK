{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["hardhat/types", "mocha", "node"]
  },
  "include": ["hardhat.config.ts", "scripts/**/*.ts", "deploy/**/*.ts", "test/**/*.ts", "typechain-types/**/*.ts"]
}
