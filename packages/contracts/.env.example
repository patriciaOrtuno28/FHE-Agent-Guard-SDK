# Sepolia deployment — copy this file to .env and fill in your values.
# NEVER commit .env — it contains your private key.

# Sepolia RPC endpoint (Alchemy or Infura recommended; public RPCs work too)
SEPOLIA_RPC_URL=https://sepolia.drpc.org

# Private key of the funded deployer wallet (with 0x prefix)
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY_HERE

# If not set, the deployer address becomes the contract owner.
# AGENT_OWNER=0x...
