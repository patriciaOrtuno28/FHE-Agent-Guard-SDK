{
  "name": "@fhe-guard/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "node": "hardhat node --no-deploy",
    "deploy:localhost": "hardhat deploy --network localhost",
    "deploy:sepolia": "hardhat deploy --network sepolia",
    "export:sdk:localhost": "ts-node scripts/export-to-sdk.ts --network localhost",
    "export:sdk:sepolia": "ts-node scripts/export-to-sdk.ts --network sepolia",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf ./artifacts ./cache ./deployments/sepolia ./types"
  },
  "dependencies": {
    "@fhevm/solidity": "0.10.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.0.2",
    "encrypted-types": "0.0.4"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.3.0-4",
    "@fhevm/mock-utils": "0.3.0-4",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/node": "^20.19.8",
    "@zama-fhe/relayer-sdk": "0.3.0-8",
    "dotenv": "^17.3.1",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.0",
    "hardhat-deploy": "^0.11.45",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.8.3"
  }
}
